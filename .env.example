BITGET_BASE_URL=https://api.bitget.com
BITGET_SYMBOL=RMUUSDT
BITGET_SYMBOL_LIMIT=5
PORT=3000
AFTERMRKT_HOST=127.0.0.1
# AFTERMRKT_DATA_DIR=.agent/data
# AFTERMRKT_EVENT_REPLAY_DATA_DIR=
MCP_ENDPOINT=https://agent.bitget.com/mcp
MCP_NATIVE_TICKER=MU
QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
QWEN_MODEL=qwen3.8-max
QWEN_THINKING_MODE=disabled
QWEN_REQUEST_TIMEOUT_MS=45000
QWEN_MAX_OUTPUT_TOKENS=1200
AFTERMRKT_ASSISTANT_RATE_PER_MINUTE=10
AFTERMRKT_ASSISTANT_DAILY_CAP=500
SEC_USER_AGENT=AfterMrkt/0.1 (contact: your-email@example.com)
# SEC_USER_AGENT is required for server-side SEC EDGAR requests.

# Set credentials only in a local untracked environment when authorized.
# QWEN_API_KEY=
# BITGET_DEMO_API_KEY=
# BITGET_DEMO_API_SECRET=
# BITGET_DEMO_PASSPHRASE=
